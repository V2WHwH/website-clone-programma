# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en hoort nooit gecommit te worden.

# ---- HereWeHolo Holobox Platform ----

# Wachtwoord voor het CMS (/admin). VERPLICHT aanpassen voor productie.
ADMIN_PASSWORD=

# Poort waarop het platform draait (HTTP + WebSocket).
PORT=8080

# Externe basis-URL van dit platform, gebruikt voor absolute media-URL's in
# manifests. Laat leeg om de URL uit het request af te leiden.
# Voorbeeld: https://cms.hereweholo.nl
PUBLIC_BASE_URL=

# ---- AI-avatars (LemonSlice) ----

# De geheime sleutel van je LemonSlice-account. Hij blijft op deze server:
# de holobox vraagt een sessie aan met zijn eigen device-key en krijgt alleen
# het kamer-adres terug. Dit is de enige regel die je moet invullen.
# De server stuurt hem mee als header x-api-key.
#
# Dit is de sleutel van het huis: hij geldt voor elke holobox die er geen
# eigen heeft. Wil een klant op zijn eigen LemonSlice-account draaien, vul
# dan bij die holobox in het beheerscherm het veld LemonSlice-sleutel in;
# die gaat dan voor.
LEMONSLICE_API_KEY=

# Het endpoint waarmee je een sessie start. Leeg laten betekent het huidige
# adres van LemonSlice: https://lemonslice.com/api/liveai/sessions
# Vul het alleen in als LemonSlice je een ander adres geeft.
LEMONSLICE_SESSION_URL=

# Alleen nodig als hun antwoord andere veldnamen gebruikt dan de gangbare.
# LemonSlice antwoordt vandaag met session_id, room_url en control_url; die
# herkent de server zelf al. De server meldt anders welke velden hij wél
# terugkreeg, dan vul je hier de juiste naam in.
LEMONSLICE_URL_FIELD=
LEMONSLICE_TOKEN_FIELD=

# ---- Ditto MCP (bestaande koppeling, los van het holobox-platform) ----

# API key voor de Ditto MCP-server (https://api.ditto.site/mcp).
# Wordt door .mcp.json ingevuld in de Authorization-header als "Bearer <key>".
DITTO_API_KEY=
