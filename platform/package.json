{
  "name": "@hereweholo/platform",
  "version": "0.1.0",
  "private": true,
  "description": "HoloMe / HoloSee platform - M2 (SFU media path), M3 (identity, orgs, devices, pairing), M4 (the session).",
  "type": "module",
  "scripts": {
    "build": "esbuild web/login.ts web/app.ts web/session.ts web/join.ts web/receiver.ts --bundle --format=esm --outdir=public/js --sourcemap",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx server/migrate.ts",
    "start": "npm run build && tsx server/index.ts",
    "test": "npm run build && node --test test/",
    "test:api": "node --test test/api.test.mjs",
    "test:e2e": "npm run build && node test/e2e-media.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "express": "^4.19.2",
    "jose": "^5.9.2",
    "livekit-client": "^2.5.7",
    "livekit-server-sdk": "^2.7.2",
    "pg": "^8.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.23.1",
    "playwright-core": "^1.46.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
