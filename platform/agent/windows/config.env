# HEREweHOLO Beam Receiver — agent configuration
# Lines are KEY=VALUE. The process environment always wins over this file.
# This file is preserved on update; edit it once per machine.

# REQUIRED: the receiver page on your Beam platform
RECEIVER_URL=https://beam.example.com/receiver.html

# Browser to run in kiosk mode. Edge ships with Windows and is Chromium-based.
CHROMIUM=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Persistent profile: this is the device identity — do NOT delete it.
PROFILE_DIR=C:\ProgramData\HEREweHOLO\holosee-profile

# Signed automatic updates (leave empty to disable)
#UPDATE_URL=https://beam.example.com/updates
#UPDATE_CHANNEL=stable
#UPDATE_PUBKEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
#AGENT_VERSION=0.3.0

# Allow the remote reboot_host action to actually reboot this machine
#ALLOW_REBOOT=1
